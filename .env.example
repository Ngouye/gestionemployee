# ---------------------------------------------------------------------------
# EmployeeManager — configuration (copier ce fichier en .env et l'adapter)
# ---------------------------------------------------------------------------

# Sécurité — générez une clé longue et aléatoire, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer-par-une-longue-cle-aleatoire
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines de confiance pour le CSRF, avec le schéma (ex. https://rh.mon-entreprise.sn)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# À activer dès que l'application est servie en HTTPS (derrière un reverse proxy)
DJANGO_SECURE_COOKIES=0
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
DJANGO_BEHIND_PROXY=0
DJANGO_TIME_ZONE=Africa/Dakar

# Base de données PostgreSQL (utilisée par docker-compose)
POSTGRES_DB=employeemanager
POSTGRES_USER=employeemanager
POSTGRES_PASSWORD=a-remplacer
# Hors Docker : DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base
# Sans DATABASE_URL, une base SQLite locale est utilisée (développement).

# Compte administrateur créé au premier démarrage
DJANGO_SUPERUSER_EMAIL=admin@mon-entreprise.sn
DJANGO_SUPERUSER_PASSWORD=a-remplacer

# Données de démonstration (1 = charger l'entreprise fictive au premier démarrage)
SEED_DEMO=0
DEMO_PASSWORD=Demo2026!

# Port d'écoute sur la machine hôte
APP_PORT=8000

# E-mails (laisser EMAIL_HOST vide pour afficher les e-mails dans les logs)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=RH <rh@mon-entreprise.sn>
EMAIL_NOTIFICATIONS=0

# Divers
MAX_UPLOAD_SIZE_MB=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
